@app.function_name(name="trigger_pipeline")
@app.route(route="trigger_pipeline", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def trigger_pipeline(req: func.HttpRequest) -> func.HttpResponse:
    """Trigger ADF pipeline with parameters."""
    logging.info('=== Pipeline Trigger Request ===')
    
    try:
        req_body = req.get_json()
        
        pipeline_params = {
