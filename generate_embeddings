        logging.info(f"ðŸ“¥ Downloaded chunk with {len(chunk_data)} documents")
        
        # Create/update index (only on first chunk)
        if chunk_number == 1:
            logging.info(f"Creating/updating index: {index_name}")
            
            index_client = SearchIndexClient(endpoint=search_endpoint, credential=credential)
            
            vector_search = VectorSearch(
                algorithms=[
                    HnswAlgorithmConfiguration(
                        name="my_vector_config",
                        parameters={"m": 4, "efConstruction": 400, "efSearch": 500, "metric": "cosine"}
                    )
                ],
                profiles=[
                    VectorSearchProfile(
                        name="my_vector_config",
                        algorithm_configuration_name="my_vector_config"
                    )
                ]
            )
            
            fields = [
                SimpleField(name="id", type=SearchFieldDataType.String, key=True),
                SearchableField(name="book_id", type=SearchFieldDataType.String, filterable=True),
                SearchableField(name="book_title", type=SearchFieldDataType.String, searchable=True),
                SearchableField(name="chapter_title", type=SearchFieldDataType.String, searchable=True),
                SearchableField(name="title", type=SearchFieldDataType.String, searchable=True),
                SearchableField(name="topic_title", type=SearchFieldDataType.String, searchable=True),
                SearchableField(name="topic_type", type=SearchFieldDataType.String, filterable=True),

# ================================
# SECTION 2: ADF PIPELINE MANAGEMENT FUNCTIONS 
# ================================

                SearchableField(name="topic_id", type=SearchFieldDataType.String, filterable=True),
                SearchableField(name="content", type=SearchFieldDataType.String, searchable=True),
                SimpleField(name="url", type=SearchFieldDataType.String),
                SearchableField(name="product", type=SearchFieldDataType.String, filterable=True),
                SearchableField(name="version", type=SearchFieldDataType.String, filterable=True),
                SearchField(
                    name="embedding",
                    type=SearchFieldDataType.Collection(SearchFieldDataType.Single),
                    searchable=True,
                    retrievable=False,
                    vector_search_dimensions=3072,
                    vector_search_profile_name="my_vector_config"
                )
            ]
            
            index = SearchIndex(name=index_name, fields=fields, vector_search=vector_search)
            index_client.create_or_update_index(index)
            
            logging.info(f"âœ… Index '{index_name}' ready")
            time.sleep(5)
        else:
            time.sleep(2)
        
        # Prepare and upload documents
        index_start_time = time.time()
        search_client = SearchClient(endpoint=search_endpoint, index_name=index_name, credential=credential)
        
        documents = []
        for item in chunk_data:
            if not item.get("content", "").strip():
                continue
            
            doc = {
                "id": str(uuid.uuid4()),
                "book_id": item.get("book_id", ""),
                "book_title": item.get("book_title", ""),
                "chapter_title": item.get("chapter_title", ""),
                "title": item.get("title", ""),
                "topic_title": item.get("topic_title", ""),
                "topic_type": item.get("topic_type", ""),
                "topic_id": item.get("topic_id", ""),
                "content": item.get("content", ""),
                "url": item.get("url", ""),
                "product": item.get("product", ""),
                "version": item.get("version", ""),
                "embedding": item.get("embedding", [])
            }
            documents.append(doc)
        
        # Upload in batches
        total_uploaded = 0
        for i in range(0, len(documents), batch_size):
            batch = documents[i:i + batch_size]
            try:
                result = search_client.upload_documents(documents=batch)
                total_uploaded += len(result)
                logging.info(f"ðŸ“¤ Uploaded batch: {total_uploaded}/{len(documents)} for chunk {chunk_number}")
            except Exception as e:
                logging.error(f"Error uploading batch: {str(e)}")
        
        index_duration = time.time() - index_start_time
        total_duration = time.time() - start_time
        
        response_data = {
            "status": "success",
            "chunk_number": chunk_number,
            "total_chunks": total_chunks,
            "documents_indexed": total_uploaded,
            "chunk_file": chunk_file_name,
            "index_name": index_name,
            "index_time_seconds": round(index_duration, 2),
            "total_time_seconds": round(total_duration, 2)
        }
        
        logging.info(f"âœ… Chunk {chunk_number} indexed successfully: {total_uploaded} documents")
        
        return func.HttpResponse(
            json.dumps(response_data),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"Index single chunk error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


