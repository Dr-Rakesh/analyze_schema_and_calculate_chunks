# FUNCTION 1: Download Dataset
@app.function_name(name="call_api_fetch_dataset")
@app.route(route="call_api_fetch_dataset", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def call_api_fetch_dataset(req: func.HttpRequest) -> func.HttpResponse:
    """Download ZIP from API using streaming and extract to blob storage."""
    logging.info('Download and extract function started')
    start_time = datetime.datetime.utcnow()
    
    try:
        req_body = req.get_json()
        data_source = req_body.get('data_source')
        product = req_body.get('product')
        release = req_body.get('release')
        format_type = req_body.get('format', 'DITA')
        language = req_body.get('language', 'en-us')
        
        if not all([data_source, product, release]):
            return func.HttpResponse(
                json.dumps({"error": "Missing required parameters: data_source, product, release"}),
                status_code=400,
                mimetype="application/json"
            )
        
        blob_service_client = get_blob_service_client()
        
        payload = {
            'data_source': data_source,
            'product': product,
            'release': release,
            'format': format_type,
            'language': language
        }
        
        headers = {
            'Content-Type': 'application/json',
            'Accept': 'application/octet-stream'
        }
        
        params = {"download": "true"}
        
        logging.info(f"Downloading dataset: {data_source}_{product}_{release}")
        
        response = requests.post(
            API_BASE_URL, 
            params=params, 
            json=payload, 
            headers=headers, 
            stream=True, 
            timeout=600
        )
        
        if response.status_code != 200:
            return func.HttpResponse(
                json.dumps({"error": f"API returned status {response.status_code}"}),
                status_code=response.status_code,
                mimetype="application/json"
            )
        
        timestamp = datetime.datetime.utcnow().strftime('%Y%m%d_%H%M%S')
        folder_name = f"{data_source}_{product}_{release}_{timestamp}"
        
        with tempfile.NamedTemporaryFile(delete=False, suffix='.zip') as temp_file:
            temp_path = temp_file.name
            total_size = 0
            
            for chunk in response.iter_content(chunk_size=8192):
                if chunk:
                    temp_file.write(chunk)
                    total_size += len(chunk)
            
            logging.info(f"Downloaded {format_bytes(total_size)}")
        
        extraction_count = 0
        container_client = blob_service_client.get_container_client(AZURE_STORAGE_CONTAINER)
        
        with zipfile.ZipFile(temp_path, 'r') as zip_ref:
            for file_info in zip_ref.filelist:
                if file_info.filename.endswith('.json') and not file_info.is_dir():
                    with zip_ref.open(file_info.filename) as file:
                        file_content = file.read()
                        blob_name = f"{folder_name}/{os.path.basename(file_info.filename)}"
                        
                        blob_client = container_client.get_blob_client(blob_name)
                        blob_client.upload_blob(
                            file_content, 
                            overwrite=True,
                            content_settings=ContentSettings(content_type='application/json')
                        )
                        extraction_count += 1
        
        os.unlink(temp_path)
        
        end_time = datetime.datetime.utcnow()
        duration = (end_time - start_time).total_seconds()
        
        logging.info(f"Extraction complete: {extraction_count} files in {duration:.2f}s")
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "folder_name": folder_name,
                "files_extracted": extraction_count,
                "download_size_bytes": total_size,
                "duration_seconds": round(duration, 2)
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"Download error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


# FUNCTION 2: Calculate Chunks
@app.function_name(name="calculate_chunks")
@app.route(route="calculate_chunks", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def calculate_chunks(req: func.HttpRequest) -> func.HttpResponse:
    """Calculate total number of chunks needed."""
    logging.info('Calculate chunks function started')
    
    try:
        req_body = req.get_json()
        parsed_file_name = req_body.get('parsed_file_name')
        chunk_size = req_body.get('chunk_size', DEFAULT_CHUNK_SIZE)
        
        if not parsed_file_name:
            return func.HttpResponse(
                json.dumps({"error": "Missing parsed_file_name parameter"}),
                status_code=400,
                mimetype="application/json"
            )
        
        blob_service_client = get_blob_service_client()
        blob_client = blob_service_client.get_blob_client(
            container=AZURE_STORAGE_CONTAINER,
            blob=parsed_file_name
        )
        
        blob_data = blob_client.download_blob().readall()
        documents = json.loads(blob_data.decode('utf-8'))
        
        total_documents = len(documents)
        total_chunks = ceil(total_documents / chunk_size)
        
        logging.info(f"Calculation: {total_documents} documents â†’ {total_chunks} chunks of {chunk_size}")
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "total_documents": total_documents,
                "chunk_size": chunk_size,
                "total_chunks": total_chunks
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"Calculate chunks error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


