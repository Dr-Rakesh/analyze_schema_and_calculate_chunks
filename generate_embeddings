# FUNCTION 10: Download SXA Dataset
@app.function_name(name="call_api_fetch_dataset_sxa")
@app.route(route="call_api_fetch_dataset_sxa", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def call_api_fetch_dataset_sxa(req: func.HttpRequest) -> func.HttpResponse:
    """Download ZIP from SXA API using streaming and extract to blob storage."""
    logging.info('SXA Download and extract function started')
    start_time = datetime.datetime.utcnow()
    
    try:
        req_body = req.get_json()
        data_source = req_body.get('data_source', 'TechDocs')
        product = req_body.get('product')
        release = req_body.get('release')
        format_type = req_body.get('format', 'DITA')
        language = req_body.get('language', 'en-us')
        
        if not all([product, release]):
            return func.HttpResponse(
                json.dumps({"error": "Missing required parameters: product, release"}),
                status_code=400,
                mimetype="application/json"
            )
        
        blob_service_client = get_blob_service_client()
        
        payload = {
            'data_source': data_source,
            'product': product,
            'release': release,
            'format': format_type,
            'language': language
        }
        
        headers = {
            'Content-Type': 'application/json',
            'Accept': 'application/octet-stream'
        }
        
        params = {"download": "true"}
        
        logging.info(f"Downloading SXA dataset: {data_source}_{product}_{release}")
        
        response = requests.post(
            API_BASE_SXA_URL, 
            params=params, 
            json=payload, 
            headers=headers, 
            stream=True, 
            timeout=600
        )
        
        if response.status_code != 200:
            return func.HttpResponse(
                json.dumps({"error": f"API returned status {response.status_code}"}),
                status_code=response.status_code,
                mimetype="application/json"
            )
        
        timestamp = datetime.datetime.utcnow().strftime('%Y%m%d_%H%M%S')
        if data_source.upper().startswith('SXA'):
            folder_name = f"{data_source}_{product}_{release}_{timestamp}"
        else:
            folder_name = f"SXA_{data_source}_{product}_{release}_{timestamp}"
        
        with tempfile.NamedTemporaryFile(delete=False, suffix='.zip') as temp_file:
            temp_path = temp_file.name
            total_size = 0
            
            for chunk in response.iter_content(chunk_size=8192):
                if chunk:
                    temp_file.write(chunk)
                    total_size += len(chunk)
            
            logging.info(f"Downloaded {format_bytes(total_size)}")
        
        extraction_count = 0
        container_client = blob_service_client.get_container_client(AZURE_STORAGE_CONTAINER)
        
        with zipfile.ZipFile(temp_path, 'r') as zip_ref:
            for file_info in zip_ref.filelist:
                if file_info.filename.endswith('.json') and not file_info.is_dir():
                    with zip_ref.open(file_info.filename) as file:
                        file_content = file.read()
                        blob_name = f"{folder_name}/{os.path.basename(file_info.filename)}"
                        
                        blob_client = container_client.get_blob_client(blob_name)
                        blob_client.upload_blob(
                            file_content, 
                            overwrite=True,
                            content_settings=ContentSettings(content_type='application/json')
                        )
                        extraction_count += 1
        
        os.unlink(temp_path)
        
        end_time = datetime.datetime.utcnow()
        duration = (end_time - start_time).total_seconds()
        
        logging.info(f"SXA Extraction complete: {extraction_count} files in {duration:.2f}s")
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "folder_name": folder_name,
                "files_extracted": extraction_count,
                "download_size_bytes": total_size,
                "duration_seconds": round(duration, 2),
                "data_source_type": "SXA"
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"SXA Download error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


# FUNCTION 11: Parse SXA Documents
@app.function_name(name="parse_documents_sxa")
@app.route(route="parse_documents_sxa", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def parse_documents_sxa(req: func.HttpRequest) -> func.HttpResponse:
    """Parse and clean SXA JSON documents - preserves all fields dynamically."""
    logging.info('SXA Parse documents function started')
    start_time = datetime.datetime.utcnow()
    
    try:
        req_body = req.get_json()
        folder_name = req_body.get('folder_name')
        data_source_type = req_body.get('data_source_type', 'SXA')
        
        if not folder_name:
            return func.HttpResponse(
                json.dumps({"error": "Missing folder_name parameter"}),
                status_code=400,
                mimetype="application/json"
            )
        
        blob_service_client = get_blob_service_client()
        container_client = blob_service_client.get_container_client(AZURE_STORAGE_CONTAINER)
        
        all_documents = []
        file_count = 0
        detected_fields = set()
        
        blobs = container_client.list_blobs(name_starts_with=f"{folder_name}/")
        
        for blob in blobs:
            if blob.name.endswith('.json') and 'consolidated_results' not in blob.name:
                blob_client = container_client.get_blob_client(blob.name)
                blob_data = blob_client.download_blob().readall()
                
                try:
                    data = json.loads(blob_data.decode('utf-8'))
                    
                    if isinstance(data, list):
                        for item in data:
                            if isinstance(item, dict):
                                # FIELD MAPPING FOR TECHDOCS: Rename topic_title → title (preserve order)
                                if data_source_type == "TechDocs" and "topic_title" in item:
                                    topic_title_value = item["topic_title"]
                                    reordered_item = {}
                                    for key, value in item.items():
                                        if key == "topic_title":
                                            reordered_item["title"] = topic_title_value
                                        else:
                                            reordered_item[key] = value
                                    item.clear()
                                    item.update(reordered_item)
                                
                                content_field = None
                                for key in ['content', 'text', 'body', 'description']:
                                    if key in item and isinstance(item.get(key), str):
                                        content_field = key
                                        break
                                
                                if content_field:
                                    cleaned_content = clean_content_text(item.get(content_field, ''))
                                    if cleaned_content.strip():
                                        truncated_content = truncate_text_to_tokens(cleaned_content, max_tokens=8000)
                                        item[content_field] = truncated_content
                                
                                detected_fields.update(item.keys())
                                all_documents.append(item)
                    
                    file_count += 1
                    
                except json.JSONDecodeError:
                    logging.warning(f"Skipping invalid JSON: {blob.name}")
        
        parsed_filename = f"{folder_name}/consolidated_results_parsed_sxa.json"
        parsed_content = json.dumps(all_documents, ensure_ascii=False, indent=2)
        
        parsed_blob_client = container_client.get_blob_client(parsed_filename)
        parsed_blob_client.upload_blob(
            parsed_content.encode('utf-8'),
            overwrite=True,
            content_settings=ContentSettings(content_type='application/json')
        )
        
        end_time = datetime.datetime.utcnow()
        duration = (end_time - start_time).total_seconds()
        
        logging.info(f"SXA Parsed {len(all_documents)} documents with {len(detected_fields)} fields from {file_count} files in {duration:.2f}s")
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "parsed_file": parsed_filename,
                "total_documents": len(all_documents),
                "files_processed": file_count,
                "detected_fields": list(detected_fields),
                "field_count": len(detected_fields),
                "duration_seconds": round(duration, 2),
                "data_source_type": "SXA"
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"SXA Parse documents error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


