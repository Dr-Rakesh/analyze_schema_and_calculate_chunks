@app.function_name(name="index_single_chunk")
@app.route(route="index_single_chunk", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def index_single_chunk(req: func.HttpRequest) -> func.HttpResponse:
    """
    Index a single embedded chunk independently.
    UPDATED: Increased wait time from 5 to 10 minutes for chunk files.
    """
    logging.info('=== Index Single Chunk Function Started ===')
    start_time = time.time()
    
    try:
        req_body = req.get_json()
        chunk_number = req_body.get('chunk_number')
        total_chunks = req_body.get('total_chunks')
        folder_name = req_body.get('folder_name')
        batch_size = req_body.get('indexing_batch_size', DEFAULT_INDEXING_BATCH_SIZE)
        custom_index_name = req_body.get('index_name')
        
        if not all([chunk_number, total_chunks, folder_name]):
            return func.HttpResponse(
                json.dumps({"error": "Missing required parameters: chunk_number, total_chunks, folder_name"}),
                status_code=400,
                mimetype="application/json"
            )
        
        # Determine index name
        if custom_index_name:
            index_name = custom_index_name.lower()
            # Preserve underscores and hyphens (both valid per Azure AI Search rules)
            index_name = ''.join(c if (c.isalnum() or c in ('_', '-')) else '-' for c in index_name)
            # Remove consecutive hyphens or underscores
            index_name = re.sub(r'-+', '-', index_name)  # Collapse multiple hyphens
            index_name = re.sub(r'_+', '_', index_name)  # Collapse multiple underscores
            # Remove leading/trailing hyphens or underscores, then truncate
            index_name = index_name.strip('-_')[:128]
        else:
            parts = folder_name.split('_')
            if len(parts) >= 3:
                product = parts[1]
                release = parts[2]
            else:
                return func.HttpResponse(
                    json.dumps({"error": "Invalid folder_name format"}),
                    status_code=400,
                    mimetype="application/json"
                )
            
            # Use underscore to preserve naming convention
            index_name = f"{product}_{release}".lower()
            # Preserve underscores and hyphens
            index_name = ''.join(c if (c.isalnum() or c in ('_', '-')) else '-' for c in index_name)
            # Remove consecutive hyphens or underscores
            index_name = re.sub(r'-+', '-', index_name)  # Collapse multiple hyphens
            index_name = re.sub(r'_+', '_', index_name)  # Collapse multiple underscores
            # Remove leading/trailing hyphens or underscores, then truncate
            index_name = index_name.strip('-_')[:128]
        
        logging.info(f"Processing chunk {chunk_number}/{total_chunks} for index '{index_name}'")
        
        # Initialize clients
        credential = DefaultAzureCredential()
        search_endpoint = f"https://{AZURE_AI_SEARCH_NAME}.search.windows.net"
        blob_service_client = get_blob_service_client()
        
        # Construct chunk file path
        chunk_folder = f"{folder_name}_embedded_chunks"
        chunk_file_name = f"{chunk_folder}/embedded_chunk_{chunk_number:03d}_of_{total_chunks:03d}.json"
        
        # OPTIMIZATION: 
        # The ADF pipeline dependency ("Completed" condition) ensures this runs after embeddings
        # If chunk file doesn't exist immediately, it means embedding failed - skip gracefully
        logging.info(f"Checking for chunk file: {chunk_file_name}")
        
        try:
            chunk_blob_client = blob_service_client.get_blob_client(
                container=AZURE_STORAGE_CONTAINER,
                blob=chunk_file_name
            )
            
            # Single immediate check - no waiting
            if not chunk_blob_client.exists():
                logging.warning(f"âš ï¸ Chunk file not found: {chunk_file_name}")
                return func.HttpResponse(
                    json.dumps({
                        "status": "skipped",
                        "chunk_number": chunk_number,
                        "total_chunks": total_chunks,
                        "chunk_file": chunk_file_name,
                        "reason": "Embedding file not found - embedding generation may have failed for this chunk",
                        "suggestion": "Check generate_embeddings logs for this chunk number"
