def sanitize_keyvault_name(name: str) -> str:
    """Sanitize secret name for Key Vault (replace underscores with hyphens)."""
    return name.replace("_", "-")


def fetch_secret_from_keyvault(name: str, default_value: str = None) -> str:
    """
    Fetch a secret from Azure Key Vault.
    Falls back to environment variable or default value if Key Vault is unavailable.
    """
    try:
        key_vault_name = os.getenv("KEY_VAULT_NAME")
        if not key_vault_name:
            logging.warning(f"KEY_VAULT_NAME not set, falling back to env var for {name}")
            return os.environ.get(name, default_value)
        
        key_vault_url = f"https://{key_vault_name}.vault.azure.net/"
        credential = DefaultAzureCredential()
        client = SecretClient(vault_url=key_vault_url, credential=credential)
        
        sanitized_name = sanitize_keyvault_name(name)
        secret = client.get_secret(sanitized_name)
        logging.info(f"Successfully fetched secret: {sanitized_name}")
        return secret.value
    except Exception as e:
        logging.warning(f"Error fetching secret '{name}' from Key Vault: {str(e)}. Falling back to env var.")
        return os.environ.get(name, default_value)


