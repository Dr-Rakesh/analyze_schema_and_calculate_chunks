# FUNCTION 13: Index Single Chunk SXA
@app.function_name(name="index_single_chunk_sxa")
@app.route(route="index_single_chunk_sxa", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def index_single_chunk_sxa(req: func.HttpRequest) -> func.HttpResponse:
    """Index a single embedded chunk with flexible schema detection."""
    logging.info('=== SXA Index Single Chunk Function Started ===')
    start_time = time.time()
    
    try:
        req_body = req.get_json()
        chunk_number = req_body.get('chunk_number')
        total_chunks = req_body.get('total_chunks')
        folder_name = req_body.get('folder_name')
        schema_metadata = req_body.get('schema_metadata')
        batch_size = req_body.get('indexing_batch_size', DEFAULT_INDEXING_BATCH_SIZE)
        custom_index_name = req_body.get('index_name')
        
        if not all([chunk_number, total_chunks, folder_name, schema_metadata]):
            return func.HttpResponse(
                json.dumps({"error": "Missing required parameters"}),
                status_code=400,
                mimetype="application/json"
            )
        
        if custom_index_name:
            index_name = custom_index_name.lower()
            index_name = ''.join(c if (c.isalnum() or c in ('_', '-')) else '-' for c in index_name)
            index_name = re.sub(r'-+', '-', index_name)
            index_name = re.sub(r'_+', '_', index_name)
            index_name = index_name.strip('-_')[:128]
        else:
            parts = folder_name.split('_')
            if len(parts) >= 3:
                product = parts[2]
                release = parts[3] if len(parts) > 3 else 'default'
            else:
                return func.HttpResponse(
                    json.dumps({"error": "Invalid folder_name format"}),
                    status_code=400,
                    mimetype="application/json"
                )
            
            index_name = f"sxa_{product}_{release}".lower()
            index_name = ''.join(c if (c.isalnum() or c in ('_', '-')) else '-' for c in index_name)
            index_name = re.sub(r'-+', '-', index_name)
            index_name = re.sub(r'_+', '_', index_name)
            index_name = index_name.strip('-_')[:128]
        
        logging.info(f"Processing SXA chunk {chunk_number}/{total_chunks} for index '{index_name}'")
        
        credential = DefaultAzureCredential()
        search_endpoint = f"https://{AZURE_AI_SEARCH_NAME}.search.windows.net"
        blob_service_client = get_blob_service_client()
        
        chunk_folder = f"{folder_name}_embedded_chunks"
        chunk_file_name = f"{chunk_folder}/embedded_chunk_{chunk_number:03d}_of_{total_chunks:03d}.json"
        
        try:
            chunk_blob_client = blob_service_client.get_blob_client(
                container=AZURE_STORAGE_CONTAINER,
                blob=chunk_file_name
            )
            
            if not chunk_blob_client.exists():
                return func.HttpResponse(
                    json.dumps({"status": "skipped", "reason": "Chunk file not found"}),
                    status_code=404,
                    mimetype="application/json"
                )
            
            properties = chunk_blob_client.get_blob_properties()
            if properties.size < 100:
                return func.HttpResponse(
                    json.dumps({"status": "skipped", "reason": "Chunk file incomplete"}),
                    status_code=400,
                    mimetype="application/json"
                )
            
        except Exception as e:
            return func.HttpResponse(
                json.dumps({"status": "error", "error": str(e)}),
                status_code=500,
                mimetype="application/json"
            )
        
        blob_data = chunk_blob_client.download_blob().readall()
        chunk_data = json.loads(blob_data.decode('utf-8'))
        
        schema_blob_client = blob_service_client.get_blob_client(
            container=AZURE_STORAGE_CONTAINER,
            blob=schema_metadata
        )
        schema_data = json.loads(schema_blob_client.download_blob().readall().decode('utf-8'))
        
        if chunk_number == 1:
            index_client = SearchIndexClient(endpoint=search_endpoint, credential=credential)
            
            vector_search = VectorSearch(
                algorithms=[
                    HnswAlgorithmConfiguration(
                        name="my_vector_config",
                        parameters={"m": 4, "efConstruction": 400, "efSearch": 500, "metric": "cosine"}
                    )
                ],
                profiles=[
                    VectorSearchProfile(
                        name="my_vector_config",
                        algorithm_configuration_name="my_vector_config"
                    )
                ]
            )
            
            fields = create_dynamic_index_fields(schema_data)
            index = SearchIndex(name=index_name, fields=fields, vector_search=vector_search)
            index_client.create_or_update_index(index)
            time.sleep(5)
        else:
            time.sleep(2)
        
        search_client = SearchClient(endpoint=search_endpoint, index_name=index_name, credential=credential)
        
        documents = []
        content_field = schema_data.get('content_field', 'content')
        
        for item in chunk_data:
            if not item.get(content_field, "").strip():
                continue
            
            doc = {"id": str(uuid.uuid4())}
            for field_name in schema_data['fields'].keys():
                if field_name in item:
                    value = item[field_name]
                    # Handle arrays based on schema field type
                    if schema_data['fields'][field_name]['type'] == 'collection':
                        # Keep as array if it's a collection field
                        doc[field_name] = value if isinstance(value, list) else [value]
                    else:
                        # Convert arrays to strings for non-collection fields
                        if isinstance(value, list):
                            doc[field_name] = ', '.join(str(v) for v in value) if value else ""
                        else:
                            doc[field_name] = value if value else ""
            doc["embedding"] = item.get("embedding", [])
            documents.append(doc)
        
        total_uploaded = 0
        for i in range(0, len(documents), batch_size):
            batch = documents[i:i + batch_size]
            try:
                result = search_client.upload_documents(documents=batch)
                total_uploaded += len(result)
            except Exception as e:
                logging.error(f"Error uploading batch: {str(e)}")
        
        total_duration = time.time() - start_time
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "chunk_number": chunk_number,
                "documents_indexed": total_uploaded,
                "index_name": index_name,
                "total_time_seconds": round(total_duration, 2),
                "data_source_type": "SXA"
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"SXA Index error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )
