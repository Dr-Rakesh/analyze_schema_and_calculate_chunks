def format_bytes(bytes_value: int) -> str:
    """Format bytes to human-readable string."""
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if bytes_value < 1024.0:
            return f"{bytes_value:.2f} {unit}"
        bytes_value /= 1024.0
    return f"{bytes_value:.2f} PB"


def get_blob_service_client():
    """Get authenticated blob service client."""
    if AZURE_STORAGE_CONNECTION_STRING:
        return BlobServiceClient.from_connection_string(AZURE_STORAGE_CONNECTION_STRING)
    else:
        credential = DefaultAzureCredential()
        account_url = f"https://{AZURE_STORAGE_ACCOUNT_NAME}.blob.core.windows.net"
        return BlobServiceClient(account_url=account_url, credential=credential)


def clean_content_text(content: str) -> str:
    """Clean content by removing reference patterns."""
    if not content or not isinstance(content, str):
        return ""
    
    patterns = [
        r'\[TopicRef::[^\]]+\]',
        r'\[TableRef::[^\]]+\]',
        r'\[ImageRef::[^\]]+\]',
        r'\[VideoRef::[^\]]+\]',
    ]
    
    cleaned_content = content
    for pattern in patterns:
        cleaned_content = re.sub(pattern, '', cleaned_content)
    
    cleaned_content = re.sub(r'\n\s*\n', '\n', cleaned_content)
    cleaned_content = re.sub(r'^\s+|\s+$', '', cleaned_content)
    
    return cleaned_content


def num_tokens_from_string(string: str, encoding_name: str = "cl100k_base") -> int:
    """Count the number of tokens in a string."""
    try:
        encoding = tiktoken.get_encoding(encoding_name)
        num_tokens = len(encoding.encode(string))
        return num_tokens
    except Exception as e:
        logging.warning(f"Error counting tokens: {str(e)}")
        return len(string) // 4  # Rough estimate


def truncate_text_to_tokens(text: str, max_tokens: int = 8000) -> str:
    """Truncate text to a maximum number of tokens."""
    try:
        encoding = tiktoken.get_encoding("cl100k_base")
        encoded = encoding.encode(text)
        if len(encoded) > max_tokens:
            truncated = encoded[:max_tokens]
            return encoding.decode(truncated)
        return text
    except Exception as e:
        logging.warning(f"Error truncating text: {str(e)}")
        # Fallback: truncate by characters
        if len(text) > max_tokens * 4:
            return text[:max_tokens * 4]
        return text


