        for blob in blobs:
            if blob.name.endswith('.json') and 'consolidated_results' not in blob.name:
                blob_client = container_client.get_blob_client(blob.name)
                blob_data = blob_client.download_blob().readall()
                
                try:
                    data = json.loads(blob_data.decode('utf-8'))
                    
                    if isinstance(data, list):
                        for item in data:
                            if isinstance(item, dict) and 'content' in item:
                                cleaned_content = clean_content_text(item.get('content', ''))
                                if cleaned_content.strip():
                                    truncated_content = truncate_text_to_tokens(cleaned_content, max_tokens=8000)
                                    
                                    all_documents.append({
                                        'book_id': item.get('book_id', ''),
                                        'book_title': item.get('book_title', ''),
                                        'chapter_title': item.get('chapter_title', ''),
                                        'title': item.get('title', ''),
                                        'topic_title': item.get('topic_title', ''),
                                        'topic_type': item.get('topic_type', ''),
                                        'topic_id': item.get('topic_id', ''),
                                        'content': truncated_content,
                                        'url': item.get('url', ''),
                                        'product': item.get('product', ''),
                                        'version': item.get('version', '')
                                    })
                    file_count += 1
                    
                except json.JSONDecodeError:
                    logging.warning(f"Skipping invalid JSON: {blob.name}")
        
        parsed_filename = f"{folder_name}/consolidated_results_parsed.json"
        parsed_content = json.dumps(all_documents, ensure_ascii=False, indent=2)
        
        parsed_blob_client = container_client.get_blob_client(parsed_filename)
        parsed_blob_client.upload_blob(
            parsed_content.encode('utf-8'),
            overwrite=True,
            content_settings=ContentSettings(content_type='application/json')
        )
        
        end_time = datetime.datetime.utcnow()
        duration = (end_time - start_time).total_seconds()
        
        logging.info(f"Parsed {len(all_documents)} documents from {file_count} files in {duration:.2f}s")
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "parsed_file": parsed_filename,
                "total_documents": len(all_documents),
                "files_processed": file_count,
                "duration_seconds": round(duration, 2)
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"Parse documents error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


# FUNCTION 4: Generate Embeddings With Exponential Backoff
@app.function_name(name="generate_embeddings")
@app.route(route="generate_embeddings", methods=["POST"], auth_level=func.AuthLevel.FUNCTION)
def generate_embeddings(req: func.HttpRequest) -> func.HttpResponse:
    """
    Generate embeddings for a single chunk with exponential backoff for rate limits.
    UPDATED: Added retry logic for 429 errors with delays up to 60 seconds.
    """
    logging.info('Generate embeddings function started')
    start_time = time.time()
    
    try:
        req_body = req.get_json()
        parsed_file_name = req_body.get('parsed_file_name')
        chunk_number = req_body.get('chunk_number')
        total_chunks = req_body.get('total_chunks')
        chunk_size = req_body.get('chunk_size', DEFAULT_CHUNK_SIZE)
        schema_metadata_file = req_body.get('schema_metadata')  # NEW: Get schema file path
        
        if not all([parsed_file_name, chunk_number, total_chunks]):
            return func.HttpResponse(
                json.dumps({"error": "Missing required parameters"}),
                status_code=400,
                mimetype="application/json"
            )
        
        logging.info(f"Processing chunk {chunk_number}/{total_chunks}")
        
        # Download parsed file
        blob_service_client = get_blob_service_client()
        
        # NEW: Load schema metadata to get correct content field
        if schema_metadata_file:
            schema_blob_client = blob_service_client.get_blob_client(
                container=AZURE_STORAGE_CONTAINER,
                blob=schema_metadata_file
            )
            schema_data = json.loads(schema_blob_client.download_blob().readall().decode('utf-8'))
            embedding_field = schema_data.get('content_field', 'content')
            logging.info(f"Using content field from schema: {embedding_field}")
        else:
            # Fallback to default
            embedding_field = req_body.get('embedding_field', 'content')
            logging.warning(f"No schema metadata provided, using field: {embedding_field}")
        
        blob_client = blob_service_client.get_blob_client(
            container=AZURE_STORAGE_CONTAINER,
            blob=parsed_file_name
        )
        
        blob_data = blob_client.download_blob().readall()
        all_documents = json.loads(blob_data.decode('utf-8'))
        
        # Extract chunk
        start_idx = (chunk_number - 1) * chunk_size
        end_idx = min(start_idx + chunk_size, len(all_documents))
        
        # Validate chunk boundaries
        if start_idx >= len(all_documents):
            logging.warning(f"âš ï¸ Chunk {chunk_number} is beyond document range. Skipping.")
            return func.HttpResponse(
                json.dumps({
                    "status": "skipped",
                    "chunk_number": chunk_number,
                    "total_chunks": total_chunks,
                    "reason": "Chunk number exceeds total documents",
                    "documents_processed": 0
                }),
                status_code=200,
                mimetype="application/json"
            )
        
        chunk_documents = all_documents[start_idx:end_idx]
        
        if len(chunk_documents) == 0:
            logging.warning(f"âš ï¸ Chunk {chunk_number} contains 0 documents. Skipping.")
            return func.HttpResponse(
                json.dumps({
                    "status": "skipped",
                    "chunk_number": chunk_number,
                    "total_chunks": total_chunks,
                    "reason": "Empty chunk",
                    "documents_processed": 0
                }),
                status_code=200,
                mimetype="application/json"
            )
        
        logging.info(f"Processing {len(chunk_documents)} documents (indices {start_idx} to {end_idx-1})")
        
        # Initialize credentials
        credential = DefaultAzureCredential()
        token_provider = get_bearer_token_provider(
            credential,
            "https://cognitiveservices.azure.com/.default"
        )
        
        # Prepare texts for embedding - track which docs have content
        texts = []
        doc_indices_with_content = []
        for idx, doc in enumerate(chunk_documents):
            content = doc.get(embedding_field, "")
            if content and isinstance(content, str) and content.strip():
                # CRITICAL: Truncate to 8000 tokens (embedding model limit is 8192)
                truncated = truncate_text_to_tokens(content.strip(), max_tokens=8000)
                texts.append(truncated)
                doc_indices_with_content.append(idx)
                
                # Log if truncation occurred
                if len(truncated) < len(content.strip()):
                    logging.warning(f"⚠️  Document {idx} truncated from {num_tokens_from_string(content)} to 8000 tokens")
        
        # Validation: ensure we have at least some valid texts to embed
        if not texts:
            logging.warning(f"⚠️ Chunk {chunk_number} has no valid content to embed. Skipping.")
            
            # CRITICAL FIX: Still create the chunk file with empty embeddings
            # This prevents 404 errors during indexing
            for doc in chunk_documents:
                doc['embedding'] = []  # Empty embedding for documents with no content
            
            # Save the chunk file even though we're skipping embedding generation
            folder_name = parsed_file_name.split('/')[0]
            chunk_folder = f"{folder_name}_embedded_chunks"
            chunk_file_name = f"{chunk_folder}/embedded_chunk_{chunk_number:03d}_of_{total_chunks:03d}.json"
            
            chunk_content = json.dumps(chunk_documents, ensure_ascii=False, indent=2)
            
            chunk_blob_client = blob_service_client.get_blob_client(
                container=AZURE_STORAGE_CONTAINER,
                blob=chunk_file_name
            )
            
            chunk_blob_client.upload_blob(
                chunk_content.encode('utf-8'),
                overwrite=True,
                content_settings=ContentSettings(content_type='application/json')
            )
            
            logging.info(f" Created empty chunk file: {chunk_file_name}")
            
            return func.HttpResponse(
                json.dumps({
                    "status": "skipped",
                    "chunk_number": chunk_number,
                    "total_chunks": total_chunks,
                    "reason": "No valid content",
                    "documents_processed": len(chunk_documents),
                    "chunk_file": chunk_file_name
                }),
                status_code=200,
                mimetype="application/json"
            )

        
        # Generate embeddings with exponential backoff for rate limiting
        max_retries = 15  # 15 for persistent rate limiting
        retry_delay = 3   # 3 seconds initial delay
        embeddings = []
        
        for attempt in range(max_retries):
            try:
                # Call Azure OpenAI REST API directly
                token = token_provider()
                headers = {
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {token}"
                }
                
                url = f"{AZURE_OPENAI_ENDPOINT}/openai/deployments/{AZURE_OPENAI_EMBEDDING_DEPLOYMENT}/embeddings?api-version={AZURE_OPENAI_API_VERSION}"
                
                payload = {
                    "input": texts,
                    "encoding_format": "float"
                }
                
                response = requests.post(url, headers=headers, json=payload, timeout=120)
                
                if response.status_code == 200:
                    result = response.json()
                    embeddings = [item['embedding'] for item in result['data']]
                    logging.info(f"âœ… Generated {len(embeddings)} embeddings successfully")
                    break
                    
                elif response.status_code == 429:
                    # Rate limit hit - apply exponential backoff with longer waits
                    if attempt < max_retries - 1:
                        # Exponential backoff: 3s, 6s, 12s, 24s, 48s, 96s, 120s (max)
                        wait_time = min(retry_delay * (2 ** attempt), 120)  # Max 120 seconds between retries
                        logging.warning(f"âš ï¸ Rate limit hit (429). Retrying in {wait_time}s (attempt {attempt + 1}/{max_retries})")
                        time.sleep(wait_time)
                    else:
                        logging.error(f"âŒ Rate limit persisted after {max_retries} attempts")
                        return func.HttpResponse(
                            json.dumps({
                                "error": "Rate limit exceeded after retries",
                                "status_code": 429,
                                "chunk_number": chunk_number
                            }),
                            status_code=429,
                            mimetype="application/json"
                        )
                else:
                    logging.error(f"OpenAI API error: {response.status_code} - {response.text}")
                    return func.HttpResponse(
                        json.dumps({
                            "error": f"OpenAI API error: {response.status_code}",
                            "details": response.text
                        }),
                        status_code=response.status_code,
                        mimetype="application/json"
                    )
                    
            except requests.exceptions.Timeout:
                if attempt < max_retries - 1:
                    wait_time = min(retry_delay * (2 ** attempt), 60)
                    logging.warning(f"âš ï¸ Request timeout. Retrying in {wait_time}s (attempt {attempt + 1}/{max_retries})")
                    time.sleep(wait_time)
                else:
                    logging.error(f"âŒ Request timeout after {max_retries} attempts")
                    return func.HttpResponse(
                        json.dumps({
                            "error": "Request timeout after retries",
                            "chunk_number": chunk_number
                        }),
                        status_code=504,
                        mimetype="application/json"
                    )
                    
            except Exception as e:
                logging.error(f"Unexpected error in embedding generation: {str(e)}")
                return func.HttpResponse(
                    json.dumps({"error": f"Embedding generation failed: {str(e)}"}),
                    status_code=500,
                    mimetype="application/json"
                )
        
        # Attach embeddings back to documents (only those with content get embeddings)
        embedding_idx = 0
        for doc_idx in range(len(chunk_documents)):
            if doc_idx in doc_indices_with_content:
                # This document had content - give it the embedding
                chunk_documents[doc_idx]['embedding'] = embeddings[embedding_idx]
                embedding_idx += 1
            else:
                # This document had no content - empty embedding
                chunk_documents[doc_idx]['embedding'] = []
        
        # Save embedded chunk
        folder_name = parsed_file_name.split('/')[0]
        chunk_folder = f"{folder_name}_embedded_chunks"
        chunk_file_name = f"{chunk_folder}/embedded_chunk_{chunk_number:03d}_of_{total_chunks:03d}.json"
        
        chunk_content = json.dumps(chunk_documents, ensure_ascii=False, indent=2)
        
        chunk_blob_client = blob_service_client.get_blob_client(
            container=AZURE_STORAGE_CONTAINER,
            blob=chunk_file_name
        )
        
        chunk_blob_client.upload_blob(
            chunk_content.encode('utf-8'),
            overwrite=True,
            content_settings=ContentSettings(content_type='application/json')
        )
        
        total_time = time.time() - start_time
        
        logging.info(f"âœ… Chunk {chunk_number}/{total_chunks} saved: {len(chunk_documents)} docs in {total_time:.2f}s")
        
        return func.HttpResponse(
            json.dumps({
                "status": "success",
                "chunk_number": chunk_number,
                "total_chunks": total_chunks,
                "documents_processed": len(chunk_documents),
                "embeddings_generated": len(embeddings),
                "chunk_file": chunk_file_name,
                "duration_seconds": round(total_time, 2)
            }),
            status_code=200,
            mimetype="application/json"
        )
        
    except Exception as e:
        logging.error(f"Generate embeddings error: {str(e)}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )


